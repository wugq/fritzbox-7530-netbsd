/src/
/obj/
/tooldir/
/dl/
/tftp/

# logs from the test benches
*.log

# reference sources (FreeBSD, Linux) for reading, not part of the repo
/ref/

# local notes, Chinese documents, journals, test reports, logs (not published)
/private/
# working instructions for the AI assistant (local)
/CLAUDE.md
tools/ubi/ubi-harness
