#!/bin/sh
#
# /etc/rc of the FRITZ!Box 7530 flash edition.
#
# NetBSD's init(8) runs this once at boot, then starts the getty on the
# console from /etc/ttys.  The full NetBSD system uses rc.subr and the
# scripts in /etc/rc.d; this small one does the same jobs in order, so the
# whole boot can be read in one page.  The root file system is a memory
# disk (md0) inside the boot image: changes are lost at reboot.  The
# settings are in /etc/router.conf.
#
export PATH=/sbin:/bin:/usr/sbin:/usr/bin
umask 022
. /etc/rc.settings	# config_vol, mount_usb: where the settings are kept
echo "flash edition: starting"
# red while booting, green when up: a boot that hangs stays red
sysctl -qw hw.led.info_red=1

# init(8) mounted the root read-only: make it writable (it is RAM anyway)
mount -uw /

# file systems that live in RAM or in the kernel
mount -t tmpfs tmpfs /tmp
mount -t ptyfs ptyfs /dev/pts
mount -t kernfs kernfs /kern
mount -t procfs procfs /proc
touch /var/run/utmp /var/run/utmpx /var/log/wtmp /var/log/wtmpx
touch /var/log/messages /var/log/authlog; chmod 600 /var/log/authlog
dmesg > /var/run/dmesg.boot

# --- saved settings (saveconfig(8))
# From the NAND (UBI volume "config", a tar archive) if it holds any,
# otherwise from /fritz/ on a USB stick (FFS or FAT): they replace the
# image's copies.  USB attaches after the kernel has mounted the root, so
# wait a few seconds for a disk to show up.
#
# First keep the image's own copies in /var/run/image: saveconfig leaves
# out the files that are the same as these, so a newer image's version of
# a file the owner never changed is not hidden by an old saved copy.
image_copies
if config_vol && config_has_settings; then
	echo "flash edition: settings from the NAND ($CONFIG_DEV)"
	(cd / && dd if=$CONFIG_DEV bs=126976 2>/dev/null | pax -r -pe)
else
	for i in 1 2 3 4 5 6 7 8; do
		case "$(sysctl -n hw.disknames)" in *sd0*) break ;; esac
		sleep 1
	done
	if mount_usb ro; then
		if [ -d /mnt/fritz ]; then
			echo "flash edition: settings from the USB stick ($USB_DEV)"
			(cd /mnt/fritz && pax -rw -pe . /)
		fi
		umount /mnt
	fi
fi
changed=$(for f in $(changed_settings); do
	[ -e /var/run/image$f ] && echo $f; done)
[ -z "$changed" ] || echo "flash edition: saved, not the image's:" $changed

. /etc/router.conf
hostname "$HOSTNAME"

# --- network
ifconfig lo0 inet 127.0.0.1 netmask 255.0.0.0 up
ifconfig qcomedma0 inet "$LAN_ADDR" up
if [ "${WAN_PORT:-0}" != 0 ]; then
	# one switch port becomes the WAN: 802.1Q VLAN 2, tagged to the CPU
	sysctl -qw hw.qcomess0.wan_port="$WAN_PORT"
	ifconfig vlan2 create
	ifconfig vlan2 vlan 2 vlanif qcomedma0
	ifconfig vlan2 up
	case "$WAN_MODE" in
	dhcp)	# with our own resolver, keep /etc/resolv.conf pointing at it
		if [ "${DNS:-no}" = yes ]; then
			dhcpcd -b -q -C resolv.conf vlan2
		else
			dhcpcd -b -q vlan2
		fi ;;
	static)	ifconfig vlan2 inet "$WAN_ADDR"
		[ -n "$WAN_GW" ] && route -q add default "$WAN_GW" ;;
	pppoe)	# PPP over Ethernet on the WAN port (a DSL or fibre modem);
		# the link comes up when the provider answers
		ifconfig pppoe0 create
		pppoectl -e vlan2 pppoe0
		pppoectl pppoe0 myauthproto="${PPPOE_AUTH:-chap}" \
		    myauthname="$PPPOE_USER" myauthsecret="$PPPOE_PASS" \
		    hisauthproto=none
		ifconfig pppoe0 inet 0.0.0.0 0.0.0.1 netmask 0xffffffff up
		route -q add default -iface 0.0.0.1 ;;
	esac
fi
sysctl -qw net.inet.ip.forwarding=1

# IPv6 on the LAN: an address and router advertisements (rtadvd).  The
# WAN has no IPv6, so the router does not announce itself as the default
# router (rltime 0), only the prefix and itself as DNS server (RDNSS).
if [ -n "${LAN_ADDR6:-}" ]; then
	ifconfig qcomedma0 inet6 "$LAN_ADDR6" alias
	sysctl -qw net.inet6.ip6.forwarding=1
	rdnss=
	[ "${DNS:-no}" = yes ] && rdnss=":rdnss=\"${LAN_ADDR6%/*}\""
	printf 'qcomedma0:\\\n\t:rltime#0%s:\n' "$rdnss" > /var/run/rtadvd.conf
	rtadvd -c /var/run/rtadvd.conf qcomedma0
fi

# DNS resolver for the LAN (unbound, /etc/unbound/unbound.conf): it
# answers on the LAN addresses and localhost, to the LAN only, and the
# router itself uses it too
if [ "${DNS:-no}" = yes ]; then
	{
		echo "server:"
		echo "	interface: 127.0.0.1"
		echo "	interface: ${LAN_ADDR%/*}"
		echo "	access-control: $LAN_ADDR allow"
		echo "	local-data: \"$HOSTNAME.lan. A ${LAN_ADDR%/*}\""
		if [ -n "${LAN_ADDR6:-}" ]; then
			echo "	interface: ${LAN_ADDR6%/*}"
			echo "	access-control: $LAN_ADDR6 allow"
			echo "	local-data: \"$HOSTNAME.lan. AAAA ${LAN_ADDR6%/*}\""
		fi
	} > /var/run/unbound.local.conf
	unbound -c /etc/unbound/unbound.conf
	sleep 1
	pgrep -qx unbound && echo "nameserver 127.0.0.1" > /etc/resolv.conf
fi
# Firewall and NAT (/etc/npf.conf): $lan_net from LAN_ADDR, and only the
# parts that are switched on
if [ "${FIREWALL:-no}" = yes ] || [ "$NAT" = yes ]; then
	{
		grep -q '^\$lan_net' /etc/npf.conf ||
		    echo "\$lan_net = $(lan_net "$LAN_ADDR")"
		sed -e "$([ "$NAT" = yes ] || echo '/# NAT$/d')" \
		    -e "$([ "${FIREWALL:-no}" = yes ] || echo '/# FIREWALL$/d')" \
		    /etc/npf.conf
	} > /var/run/npf.conf
	npfctl reload /var/run/npf.conf && npfctl start
fi
if [ "$DHCPD" = yes ]; then
	touch /var/db/dhcpd.leases
	dhcpd -q qcomedma0
fi

# --- services
# ssh host keys: not in the (public) image; made at the first boot,
# kept by saveconfig
# (ssh-keygen -A makes only the missing ones)
[ -f /etc/ssh/ssh_host_ed25519_key ] ||
	echo "flash edition: creating ssh host keys"
ssh-keygen -A >/dev/null
syslogd -s
/usr/sbin/sshd
[ "$NTP" = yes ] && ntpd -g -c /etc/ntp.conf
powerd	# buttons: /etc/powerd/scripts/hotkey_button

sysctl -qw hw.led.info_red=0 hw.led.info_green=1
echo "flash edition: up ($(uname -v | cut -d: -f1))"
exit 0
