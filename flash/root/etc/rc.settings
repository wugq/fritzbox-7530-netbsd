# Where the flash edition keeps its settings, for /etc/rc and saveconfig.
#
# 1. The NAND: the UBI volume named "config" (two 124 KB LEBs, created in
#    U-Boot with "ubi create config 0x3e000"), read and written through
#    the qcomqpic driver.  It holds a tar archive (ustar) of the files in
#    /etc/saveconfig.list.
# 2. A USB stick: the files under /fritz/ on it (FFS sd0a, the full NetBSD
#    stick, or FAT sd0e/sd0i).  Used when the NAND has no settings.

# config_vol -- set CONFIG_DEV to the "config" volume's device node,
# making it if needed.  The driver prints the numbers at attach:
#   qcomqpic0: UBI volume 5 "config": 2 LEBs, ...
#   qcomqpic0: volumes: character major 369, minor = volume id
config_vol() {
	local boot=/var/run/dmesg.boot id major
	[ -f $boot ] || dmesg > $boot
	# the message buffer survives a warm reset: the last match is this boot's
	id=$(sed -n 's/.*UBI volume \([0-9]*\) "config".*/\1/p' $boot | tail -1)
	major=$(sed -n 's/.*character major \([0-9]*\),.*/\1/p' $boot | tail -1)
	CONFIG_DEV=
	[ -n "$id" ] && [ -n "$major" ] || return 1
	CONFIG_DEV=/dev/ubivol$id
	[ -c $CONFIG_DEV ] || mknod $CONFIG_DEV c $major $id
}

# config_has_settings -- does the volume start with a tar header?
config_has_settings() {
	[ "$(dd if=$CONFIG_DEV bs=512 count=1 2>/dev/null |
	    dd bs=1 skip=257 count=5 2>/dev/null)" = ustar ]
}

# settings_files -- the files of /etc/saveconfig.list that exist, relative
# to / (tar members without a leading /).
settings_files() {
	grep -v '^#' /etc/saveconfig.list | grep -v '^$' |
	    while read -r f; do [ -e "$f" ] && echo "${f#/}"; done
}

# image_copies -- copy the image's versions of the settings files to
# /var/run/image, before /etc/rc puts the saved ones over them.
image_copies() {
	mkdir -p /var/run/image
	(cd / && pax -rw -pe $(settings_files) /var/run/image)
}

# changed_settings -- the settings files that are not the same as the
# image's copy (or that the image does not have: ssh host keys, ...).
changed_settings() {
	local f
	for f in $(settings_files); do
		cmp -s "/$f" "/var/run/image/$f" || echo "/$f"
	done
}

# lan_net a.b.c.d/len -- the network of an address: 192.168.77.1/24 ->
# 192.168.77.0/24
lan_net() {
	local ip=${1%/*} len=${1#*/} n
	local IFS=.
	set -- $ip
	n=$(( ($1 << 24 | $2 << 16 | $3 << 8 | $4) &
	    (0xffffffff << (32 - len)) & 0xffffffff ))
	echo "$((n >> 24 & 255)).$((n >> 16 & 255)).$((n >> 8 & 255)).$((n & 255))/$len"
}

# int2ip n -- a 32-bit number as a dotted address
int2ip() {
	echo "$(($1 >> 24 & 255)).$(($1 >> 16 & 255)).$(($1 >> 8 & 255)).$(($1 & 255))"
}

# dhcpd_subnet a.b.c.d/len [dns] -- dhcpd.conf(5) subnet declaration for
# the LAN: addresses .100-.199 of the network (the upper half of one
# smaller than /24), the router as gateway and, with "dns", as DNS server
dhcpd_subnet() {
	local ip=${1%/*} len=${1#*/} n mask size lo hi
	local IFS=.
	set -- $ip "${2:-}"
	n=$(($1 << 24 | $2 << 16 | $3 << 8 | $4))
	mask=$(( (0xffffffff << (32 - len)) & 0xffffffff ))
	n=$((n & mask)) size=$((1 << (32 - len)))
	if [ $size -ge 256 ]; then
		lo=$((n + 100)) hi=$((n + 199))
	else
		lo=$((n + size / 2)) hi=$((n + size - 2))
	fi
	echo "subnet $(int2ip $n) netmask $(int2ip $mask) {"
	echo "	range $(int2ip $lo) $(int2ip $hi);"
	echo "	option routers $ip;"
	[ "$5" = dns ] && echo "	option domain-name-servers $ip;"
	echo "}"
}

# mount_usb ro|rw -- mount the USB stick on /mnt.  Tries sd0a (FFS), then
# sd0e and sd0i (FAT).  Sets USB_DEV.  Returns 1 if none.
mount_usb() {
	local opt=-r
	[ "$1" = rw ] && opt=
	for USB_DEV in /dev/sd0a /dev/sd0e /dev/sd0i; do
		[ -b "$USB_DEV" ] || continue
		mount -t ffs $opt "$USB_DEV" /mnt 2>/dev/null && return 0
		mount -t msdos $opt "$USB_DEV" /mnt 2>/dev/null && return 0
	done
	USB_DEV=
	return 1
}
