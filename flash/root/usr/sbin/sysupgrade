#!/bin/sh
#
# sysupgrade -- install a new flash edition image, from the running system.
#
# The new image goes into the UBI volume "upgrade" (made the size of
# "kernel" the first time), is read back and compared, and then the two
# volumes swap names in one write of the volume table: U-Boot boots the
# volume named "kernel", so the next boot runs the new system, and the old
# one stays in "upgrade".  A power failure at any point leaves either the
# old system or the new one bootable, never half of each.  The saved
# settings (volume "config") are not touched.
#
#   sysupgrade [-n] file	install file (- : read it from standard input)
#				and reboot (-n: do not reboot)
#   sysupgrade -r [-n]		roll back: swap "kernel" and "upgrade" again
#
# From the PC:  ssh root@192.168.77.1 sysupgrade - < netbsd-flash.itb
#
export PATH=/sbin:/bin:/usr/sbin:/usr/bin
LEB=126976
tmp=/tmp/sysupgrade.itb

die() { echo "sysupgrade: $*" >&2; rm -f $tmp; exit 1; }

# vol NAME -- "id LEBs" of a volume, empty if there is none
vol() {
	sysctl -n hw.qcomqpic0.ubi_volumes 2>/dev/null |
	    awk -v n="$1" '$2 == n { print $1, $3 }'
}

# voldev ID -- the device node of a volume (the major is printed at attach)
voldev() {
	local major
	[ -f /var/run/dmesg.boot ] || dmesg > /var/run/dmesg.boot
	major=$(sed -n 's/.*qcomqpic0: volumes: character major \([0-9]*\),.*/\1/p' \
	    /var/run/dmesg.boot | tail -1)
	[ -n "$major" ] || die "no qcomqpic0 volumes line in dmesg"
	[ -c /dev/ubivol$1 ] || mknod /dev/ubivol$1 c $major $1
	echo /dev/ubivol$1
}

# is_image FILE -- a FIT image made for this box, and not the USB kernel
is_image() {
	[ "$(dd if="$1" bs=4 count=1 2>/dev/null | od -An -tx1 | tr -d ' \n')" = \
	    d00dfeed ] &&
	    dd if="$1" bs=4096 count=1 2>/dev/null |
	    grep -aq 'NetBSD for FRITZ!Box 7530' &&
	    [ "$(wc -c < "$1")" -gt 8000000 ]
}

reboot=yes
rollback=no
while getopts nr o; do
	case $o in
	n)	reboot=no ;;
	r)	rollback=yes ;;
	*)	echo "usage: sysupgrade [-n] file | -r [-n]" >&2; exit 2 ;;
	esac
done
shift $((OPTIND - 1))
[ -n "$(vol kernel)" ] || die "no UBI volume \"kernel\" (not installed in the flash?)"

if [ $rollback = yes ]; then
	[ $# -eq 0 ] || { echo "usage: sysupgrade -r [-n]" >&2; exit 2; }
	set -- $(vol upgrade)
	[ -n "$1" ] || die "no UBI volume \"upgrade\": nothing to roll back to"
	is_image "$(voldev $1)" || die "\"upgrade\" holds no image"
	sysctl -w hw.qcomqpic0.ubi_swap="kernel upgrade" >/dev/null ||
	    die "swapping the names failed (dmesg)"
	echo "sysupgrade: the previous system is \"kernel\" again"
else
	[ $# -eq 1 ] || { echo "usage: sysupgrade [-n] file" >&2; exit 2; }
	if [ "$1" = - ]; then
		cat > $tmp || die "reading standard input failed"
		img=$tmp
	else
		img=$1
	fi
	[ -f "$img" ] || die "$img: no such file"
	is_image "$img" || die "$img: not a flash edition image (netbsd-flash.itb)"
	size=$(wc -c < "$img" | tr -d ' ')
	sum=$(cksum -a sha256 < "$img")
	echo "sysupgrade: image $size bytes, SHA256 $sum"

	set -- $(vol kernel)
	klebs=$2
	if [ -z "$(vol upgrade)" ]; then
		sysctl -w hw.qcomqpic0.ubi_create="upgrade $klebs" >/dev/null ||
		    die "creating the volume \"upgrade\" failed (dmesg)"
	fi
	set -- $(vol upgrade)
	id=$1 lebs=$2
	[ "$size" -le $((lebs * LEB)) ] ||
	    die "the image is larger than the volume ($((lebs * LEB)) bytes)"
	dev=$(voldev $id)

	echo "sysupgrade: writing $dev (\"upgrade\")"
	dd if="$img" of=$dev bs=$LEB conv=sync 2>/dev/null ||
	    die "writing $dev failed (dmesg)"
	n=$(( (size + LEB - 1) / LEB ))
	got=$(dd if=$dev bs=$LEB count=$n 2>/dev/null | head -c $size |
	    cksum -a sha256)
	[ "$got" = "$sum" ] || die "read back: SHA256 $got, not $sum"
	rm -f $tmp
	echo "sysupgrade: read back, same SHA256"

	sysctl -w hw.qcomqpic0.ubi_swap="kernel upgrade" >/dev/null ||
	    die "swapping the names failed (dmesg); the old system stays"
	echo "sysupgrade: the new system is \"kernel\"; the old one is \"upgrade\""
fi

sync
if [ $reboot = yes ]; then
	echo "sysupgrade: rebooting"
	reboot
else
	echo "sysupgrade: reboot to run it"
fi
