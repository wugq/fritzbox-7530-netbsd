# Programs, data files and directories copied from the NetBSD 11.1 userland on the USB
# stick into the flash edition's root.  Their shared libraries are found
# with ldd(1) by mkroot.sh.  One path per line; "#" starts a comment.

# --- the dynamic linker
/libexec/ld.elf_so
/usr/libexec/ld.elf_so

