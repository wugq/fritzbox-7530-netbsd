GENERIC (armv7): enable the IPQ40xx SoC and attach its devices, each in
the section where its kind lives; a commented EARLYCONS line like the other
SoCs; NET_MPSAFE and GATEWAY for routing performance.

diff --git a/sys/arch/evbarm/conf/GENERIC b/sys/arch/evbarm/conf/GENERIC
index df7ac28d6..61275ae31 100644
--- a/sys/arch/evbarm/conf/GENERIC
+++ b/sys/arch/evbarm/conf/GENERIC
@@ -10,6 +10,10 @@ include	"arch/evbarm/conf/GENERIC.common"
 
 options 	CPU_CORTEX
 
+# Routing: TCP/IP without the big kernel lock, IP forwarding fast path
+options 	NET_MPSAFE
+options 	GATEWAY
+
 options 	SOC_AM33XX
 options 	SOC_BCM2836
 options 	SOC_EXYNOS5422
@@ -18,6 +22,7 @@ options 	SOC_IMX6Q
