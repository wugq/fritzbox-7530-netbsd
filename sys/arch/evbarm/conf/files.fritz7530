#	$NetBSD$
#
# Configuration info for the FRITZ7530 kernel: files.generic with only the
# Qualcomm SoC files.  (files.generic includes every SoC's files, and some
# of them, e.g. Broadcom's bcm283x_platform.c, refuse to compile unless
# their SOC_ option is set, so a one-SoC kernel can't use it.)
#

include "arch/arm/pic/files.pic"
include "arch/arm/cortex/files.cortex"

include "arch/evbarm/conf/files.fdt"

file	arch/arm/arm32/arm32_boot.c
file	arch/arm/arm32/arm32_kvminit.c
file	arch/arm/arm32/arm32_reboot.c
file	arch/arm/arm32/irq_dispatch.S
file	arch/arm/arm32/armv7_generic_space.c
file	arch/arm/arm/arm_generic_dma.c
file	arch/arm/arm/bus_space_a4x.S

# the board's SoC
include "arch/arm/qcom/files.qcom"

#
# Stack-less Just-In-Time compiler
#
include	"external/bsd/sljit/conf/files.sljit"
